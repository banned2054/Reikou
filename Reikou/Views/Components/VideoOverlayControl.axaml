<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:components="clr-namespace:Reikou.Views.Components"
                    xmlns:models="clr-namespace:Reikou.Models">
    <Design.PreviewWith>
        <Border Padding="20" Background="Black" Width="800" Height="200">
            <components:VideoOverlayControl Title="Test Video" CurrentTime="10" Duration="100"
                                            TimeText="00:10 / 01:40" />
        </Border>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type components:VideoOverlayControl}" TargetType="components:VideoOverlayControl">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid x:Name="OverlayControls" RowDefinitions="Auto,*,Auto">
                    <Grid.Styles>
                        <Style Selector="Border.PlaylistPopup">
                            <Setter Property="Padding" Value="12" />
                        </Style>
                    </Grid.Styles>
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Height="60" VerticalAlignment="Top">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                <GradientStop Offset="0" Color="#99000000" />
                                <GradientStop Offset="1" Color="#00000000" />
                            </LinearGradientBrush>
                        </Grid.Background>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="15,0">
                            <TextBlock x:Name="VideoText"
                                       Text="{TemplateBinding Title}"
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel x:Name="PART_TopRightToolArea"
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    Margin="0,0,15,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Grid>
                                <Button x:Name="PART_PlaylistButton"
                                        Classes="IconButton"
                                        Width="40"
                                        Height="40">
                                    <Svg Path="avares://Reikou/Assets/ico-list.svg"
                                         Width="22"
                                         Height="22"
                                         Stretch="Uniform" />
                                </Button>
                                <Popup x:Name="PART_PlaylistPopup"
                                       IsOpen="{Binding IsPlaylistPopupOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                       Placement="Bottom"
                                       PlacementTarget="{Binding ElementName=PART_PlaylistButton}"
                                       HorizontalOffset="-140"
                                       VerticalOffset="8"
                                       IsLightDismissEnabled="True">
                                    <Border x:Name="PART_PlaylistPopupPanel"
                                            Classes="OverlayPopupPanel PlaylistPopup"
                                            Width="320"
                                            MaxHeight="360">
                                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="播放列表"
                                                           Foreground="White"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <Button Grid.Column="1"
                                                        Classes="IconButton"
                                                        Width="28"
                                                        Height="28"
                                                        Padding="0"
                                                        Command="{Binding AddPlaylistItemCommand, RelativeSource={RelativeSource TemplatedParent}}">
                                                    <ToolTip.Tip>添加视频</ToolTip.Tip>
                                                    <TextBlock Text="+"
                                                               Foreground="White"
                                                               FontSize="20"
                                                               LineHeight="20"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Button>
                                            </Grid>
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Title, RelativeSource={RelativeSource TemplatedParent}}"
                                                       Foreground="#B3FFFFFF"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                            <ScrollViewer Grid.Row="2"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          VerticalScrollBarVisibility="Auto">
                                                <ItemsControl
                                                    ItemsSource="{Binding PlaylistItems, RelativeSource={RelativeSource TemplatedParent}}">
                                                    <ItemsControl.Styles>
                                                        <Style Selector="ContentPresenter">
                                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                        </Style>
                                                    </ItemsControl.Styles>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:PlaylistItem">
                                                            <Button Classes="PlaylistItemButton"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Padding="0"
                                                                    HorizontalAlignment="Stretch"
                                                                    Tag="{Binding RemovePlaylistItemCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                                    HorizontalContentAlignment="Stretch">
                                                                <Button.ContextMenu>
                                                                    <ContextMenu>
                                                                        <MenuItem Header="删除"
                                                                                  Command="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                  CommandParameter="{Binding}" />
                                                                    </ContextMenu>
                                                                </Button.ContextMenu>
                                                                <ToolTip.Tip>
                                                                    <TextBlock Text="{Binding Title}"
                                                                               MaxWidth="280"
                                                                               TextWrapping="Wrap" />
                                                                </ToolTip.Tip>
                                                                <Border Padding="10,8"
                                                                        CornerRadius="8"
                                                                        Background="#14000000">
                                                                    <Grid ColumnDefinitions="10,*,Auto"
                                                                          ColumnSpacing="12">
                                                                        <Border Width="6"
                                                                                Height="6"
                                                                                CornerRadius="3"
                                                                                Background="#FF5AC8FA"
                                                                                VerticalAlignment="Center"
                                                                                HorizontalAlignment="Left"
                                                                                IsVisible="{Binding IsPlaying}" />
                                                                        <TextBlock Text="{Binding Title}"
                                                                                Grid.Column="1"
                                                                                Foreground="White"
                                                                                VerticalAlignment="Center"
                                                                                TextTrimming="CharacterEllipsis"
                                                                                TextWrapping="NoWrap" />
                                                                        <TextBlock Grid.Column="2"
                                                                                Text="{Binding DurationText}"
                                                                                Foreground="#B3FFFFFF"
                                                                                VerticalAlignment="Center"
                                                                                HorizontalAlignment="Right" />
                                                                    </Grid>
                                                                </Border>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </Popup>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" VerticalAlignment="Bottom">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                <GradientStop Offset="0" Color="#00000000" />
                                <GradientStop Offset="1" Color="#CC000000" />
                            </LinearGradientBrush>
                        </Grid.Background>

                        <!-- Delegated to sub-control, but keep the PART_ name so code-behind can find it -->
                        <components:VideoTransportControls x:Name="PART_TransportControls"
                                                           CurrentTime="{Binding CurrentTime, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                           Duration="{Binding Duration, RelativeSource={RelativeSource TemplatedParent}}"
                                                           IsPlaying="{Binding IsPlaying, RelativeSource={RelativeSource TemplatedParent}}"
                                                           TimeText="{Binding TimeText, RelativeSource={RelativeSource TemplatedParent}}"
                                                           PlaybackSpeed="{Binding PlaybackSpeed, RelativeSource={RelativeSource TemplatedParent}}"
                                                           PlaybackSpeedText="{Binding PlaybackSpeedText, RelativeSource={RelativeSource TemplatedParent}}"
                                                           Volume="{Binding Volume, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                           IsMuted="{Binding IsMuted, RelativeSource={RelativeSource TemplatedParent}}"
                                                           IsVolumeFlyoutOpen="{Binding IsVolumeFlyoutOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                           IsPointerOverFlyout="{Binding IsPointerOverFlyout, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                           IsFullscreen="{Binding IsFullscreen, RelativeSource={RelativeSource TemplatedParent}}"
                                                           PlayPauseCommand="{Binding PlayPauseCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                           PreviousCommand="{Binding PreviousCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                           BackwardCommand="{Binding BackwardCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                           ForwardCommand="{Binding ForwardCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                           NextCommand="{Binding NextCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                           ToggleMuteCommand="{Binding ToggleMuteCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                           ToggleDanmakuCommand="{Binding ToggleDanmakuCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                           ChangeSpeedCommand="{Binding ChangeSpeedCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                           ToggleFullscreenCommand="{Binding ToggleFullscreenCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>

                    <StackPanel x:Name="PART_RightToolArea"
                                Grid.RowSpan="3"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,16,0"
                                Spacing="12">
                        <Button
                            Command="{Binding TakeScreenshotCommand, RelativeSource={RelativeSource TemplatedParent}}"
                            Classes="IconButton"
                            Width="40"
                            Height="40">
                            <Svg Path="avares://Reikou/Assets/ico-screenshot.svg"
                                 Width="22"
                                 Height="22"
                                 Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
