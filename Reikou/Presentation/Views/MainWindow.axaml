<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Reikou.ViewModels"
        xmlns:player="clr-namespace:Reikou.Presentation.Views.Player"
        xmlns:danmaku="clr-namespace:Banned.Avalonia.Danmaku.Views;assembly=Banned.Avalonia.Danmaku"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Reikou.Presentation.Views.MainWindow"
        x:DataType="viewModels:MainWindowViewModel"
        Title="Reikou"
        MinWidth="760"
        MinHeight="600"
        ClosingBehavior="OwnerAndChildWindows"
        DragDrop.AllowDrop="True">

    <Panel x:Name="PlayerSurface" Background="Black">
        <player:LiveResizeViewportHost x:Name="LiveResizeViewport"
                                         ResizeEndDelay="0:0:0.16">
            <Panel>
                <player:MpvVideoView x:Name="Player" />

                <player:AspectRatioContentHost x:Name="DanmakuContentHost">
                    <danmaku:DanmakuPlayerView x:Name="DanmakuLayer"
                                               IsHitTestVisible="False" />
                </player:AspectRatioContentHost>
            </Panel>
        </player:LiveResizeViewportHost>

        <Panel Background="Transparent"
               PointerPressed="OnVideoPointerPressed"
               PointerReleased="OnVideoPointerReleased" />

        <player:VideoOverlayControl x:Name="OverlayControls"
                                        CurrentTime="{Binding CurrentTime, Mode=TwoWay}"
                                        Duration="{Binding Duration}"
                                        IsPlaying="{Binding IsPlaying}"
                                        PlaylistItems="{Binding Playlist.Items}"
                                        TimeText="{Binding TimeText}"
                                        PlaybackSpeed="{Binding PlaybackSpeed}"
                                        PlaybackSpeedText="{Binding PlaybackSpeedText}"
                                        Volume="{Binding Volume, Mode=TwoWay}"
                                        MaximumVolume="{Binding MaximumVolume}"
                                        IsMuted="{Binding IsMuted}"
                                        IsFullscreen="{Binding IsFullscreen}"
                                        PlayPauseCommand="{Binding PlayPauseCommand}"
                                        PreviousCommand="{Binding PreviousCommand}"
                                        BackwardCommand="{Binding BackwardCommand}"
                                        ForwardCommand="{Binding ForwardCommand}"
                                        NextCommand="{Binding NextCommand}"
                                        ToggleMuteCommand="{Binding ToggleMuteCommand}"
                                        ToggleDanmakuCommand="{Binding ToggleDanmakuCommand}"
                                        ChangeSpeedCommand="{Binding ChangeSpeedCommand}"
                                        TakeScreenshotCommand="{Binding TakeScreenshotCommand}"
                                        OpenSettingsCommand="{Binding OpenSettingsCommand}"
                                        AddPlaylistItemCommand="{Binding AddPlaylistItemCommand}"
                                        RemovePlaylistItemCommand="{Binding RemovePlaylistItemCommand}"
                                        SelectPlaylistItemCommand="{Binding SelectPlaylistItemCommand}"
                                        ToggleFullscreenCommand="{Binding ToggleFullscreenCommand}"
                                        SeekStarted="OnSeekStarted"
                                        SeekEnded="OnSeekEnded"
                                        SeekMoved="OnSeekMoved" />
    </Panel>
</Window>
