<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:Reikou.ViewModels"
        xmlns:settings="clr-namespace:Reikou.Presentation.Views.Settings"
        x:Class="Reikou.Presentation.Views.SettingsWindow"
        x:DataType="viewModels:SettingsViewModel"
        Title="Reikou 设置"
        Width="1160"
        Height="780"
        MinWidth="900"
        MinHeight="580"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Dark"
        Background="{DynamicResource SettingsBackgroundBrush}"
        KeyDown="OnKeyDown">
    <settings:SettingsPanel />
</Window>
