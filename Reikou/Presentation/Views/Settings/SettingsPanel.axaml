<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Reikou.ViewModels"
             x:Class="Reikou.Presentation.Views.Settings.SettingsPanel"
             x:DataType="viewModels:SettingsViewModel">

    <UserControl.DataTemplates>
        <DataTemplate DataType="{x:Type viewModels:ToggleSettingViewModel}"
                      x:DataType="viewModels:ToggleSettingViewModel">
            <Border Classes="SettingRow">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <StackPanel Spacing="5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="SettingTitle" Text="{Binding Title}" />
                            <Border Classes="RestartMark"
                                    IsVisible="{Binding RestartRequired}">
                                <TextBlock Text="重启生效" />
                            </Border>
                        </StackPanel>
                        <TextBlock Classes="SettingDescription" Text="{Binding Description}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  Classes="SettingControl"
                                  IsChecked="{Binding Value, Mode=TwoWay}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:ChoiceSettingViewModel}"
                      x:DataType="viewModels:ChoiceSettingViewModel">
            <Border Classes="SettingRow">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <StackPanel Spacing="5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="SettingTitle" Text="{Binding Title}" />
                            <Border Classes="RestartMark"
                                    IsVisible="{Binding RestartRequired}">
                                <TextBlock Text="重启生效" />
                            </Border>
                        </StackPanel>
                        <TextBlock Classes="SettingDescription" Text="{Binding Description}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              Classes="SettingControl"
                              Width="320"
                              ItemsSource="{Binding Choices}"
                              SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                              VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:SettingChoice">
                                <TextBlock Text="{Binding Label}" Foreground="#F2F4F8" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:NumberSettingViewModel}"
                      x:DataType="viewModels:NumberSettingViewModel">
            <Border Classes="SettingRow">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <StackPanel Spacing="5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="SettingTitle" Text="{Binding Title}" />
                            <Border Classes="RestartMark"
                                    IsVisible="{Binding RestartRequired}">
                                <TextBlock Text="重启生效" />
                            </Border>
                        </StackPanel>
                        <TextBlock Classes="SettingDescription" Text="{Binding Description}" />
                    </StackPanel>
                    <Grid Grid.Column="1"
                          Width="320"
                          ColumnDefinitions="*,96,Auto"
                          ColumnSpacing="10"
                          VerticalAlignment="Center">
                        <Slider Classes="SettingControl"
                                Minimum="{Binding Minimum}"
                                Maximum="{Binding Maximum}"
                                TickFrequency="{Binding Increment}"
                                Value="{Binding SliderValue, Mode=TwoWay}"
                                VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1"
                                       Classes="SettingControl"
                                       Width="96"
                                       ShowButtonSpinner="False"
                                       Minimum="{Binding Minimum}"
                                       Maximum="{Binding Maximum}"
                                       Increment="{Binding Increment}"
                                       Value="{Binding NumericValue, Mode=TwoWay}"
                                       FormatString="0.####">
                            <NumericUpDown.InnerRightContent>
                                <StackPanel Margin="0,0,2,0"
                                            Spacing="1"
                                            VerticalAlignment="Center">
                                    <RepeatButton Classes="StepButton"
                                                  Click="NumberStepUp"
                                                  CommandParameter="{Binding}"
                                                  ToolTip.Tip="增加">
                                        <PathIcon Width="10"
                                                  Height="6"
                                                  Data="{StaticResource Icon.ChevronUp}" />
                                    </RepeatButton>
                                    <RepeatButton Classes="StepButton"
                                                  Click="NumberStepDown"
                                                  CommandParameter="{Binding}"
                                                  ToolTip.Tip="减少">
                                        <PathIcon Width="10"
                                                  Height="6"
                                                  Data="{StaticResource Icon.ChevronDown}" />
                                    </RepeatButton>
                                </StackPanel>
                            </NumericUpDown.InnerRightContent>
                        </NumericUpDown>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Suffix}"
                                   Foreground="#9AA1AB"
                                   FontSize="12.5"
                                   MinWidth="24"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:PathSettingViewModel}"
                      x:DataType="viewModels:PathSettingViewModel">
            <Border Classes="SettingRow">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <StackPanel Spacing="5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="SettingTitle" Text="{Binding Title}" />
                            <Border Classes="RestartMark"
                                    IsVisible="{Binding RestartRequired}">
                                <TextBlock Text="重启生效" />
                            </Border>
                        </StackPanel>
                        <TextBlock Classes="SettingDescription" Text="{Binding Description}" />
                    </StackPanel>
                    <Grid Grid.Column="1"
                          Width="320"
                          ColumnDefinitions="*,36"
                          ColumnSpacing="8"
                          VerticalAlignment="Center">
                        <TextBox Classes="SettingControl"
                                 Text="{Binding Value, Mode=TwoWay}"
                                 VerticalContentAlignment="Center" />
                        <Button Grid.Column="1"
                                Classes="BrowseButton"
                                Click="BrowsePath"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="选择路径">
                            <PathIcon Width="15"
                                      Height="15"
                                      Foreground="#A6ADB8"
                                      Data="{StaticResource Icon.Folder}" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:TextSettingViewModel}"
                      x:DataType="viewModels:TextSettingViewModel">
            <Border Classes="SettingRow">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <StackPanel Spacing="5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="SettingTitle" Text="{Binding Title}" />
                            <Border Classes="RestartMark"
                                    IsVisible="{Binding RestartRequired}">
                                <TextBlock Text="重启生效" />
                            </Border>
                        </StackPanel>
                        <TextBlock Classes="SettingDescription" Text="{Binding Description}" />
                    </StackPanel>
                    <TextBox Grid.Column="1"
                             Classes="SettingControl"
                             Width="320"
                             Text="{Binding Value, Mode=TwoWay}"
                             VerticalContentAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:ReadOnlySettingViewModel}"
                      x:DataType="viewModels:ReadOnlySettingViewModel">
            <Border Classes="SettingRow">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <StackPanel Spacing="5" VerticalAlignment="Center">
                        <TextBlock Classes="SettingTitle" Text="{Binding Title}" />
                        <TextBlock Classes="SettingDescription" Text="{Binding Description}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Value}"
                               Foreground="#C9CDD4"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid ColumnDefinitions="240,*" Background="{DynamicResource SettingsBackgroundBrush}">
        <!-- 左侧分类导航 -->
        <Border Background="{DynamicResource SettingsSidebarBrush}"
                BorderBrush="#0FFFFFFF"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*">
                <StackPanel Margin="22,30,22,16" Spacing="3">
                    <TextBlock Text="设置"
                               Foreground="#F2F4F8"
                               FontSize="21"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Reikou 播放器"
                               Foreground="#6E7580"
                               FontSize="12" />
                </StackPanel>
                <ListBox Grid.Row="1"
                         Classes="SettingsNavigation"
                         ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:SettingsCategoryViewModel">
                            <Grid Height="40">
                                <Border Width="3"
                                        Height="16"
                                        Margin="5,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="#60A5FA"
                                        CornerRadius="1.5"
                                        IsVisible="{Binding $parent[ListBoxItem].IsSelected}" />
                                <TextBlock Text="{Binding Title}"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Margin="16,0,12,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- 右侧内容区 -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
            <Grid Margin="36,32,36,0" ColumnDefinitions="*,Auto">
                <StackPanel Margin="0,0,28,0" Spacing="7" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ContentTitle}"
                               Foreground="#F2F4F8"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ContentDescription}"
                               Foreground="#9AA1AB"
                               FontSize="12.5"
                               TextWrapping="Wrap"
                               MaxWidth="560" />
                </StackPanel>
                <Grid Grid.Column="1" Width="300" VerticalAlignment="Center">
                    <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                             Classes="SearchBox"
                             PlaceholderText="搜索设置" />
                    <PathIcon Width="15"
                              Height="15"
                              Margin="14,0,0,0"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              IsHitTestVisible="False"
                              Foreground="#6E7580"
                              Data="{StaticResource Icon.Search}" />
                </Grid>
            </Grid>

            <Border Grid.Row="1"
                    Margin="36,20,36,0"
                    Padding="14,11"
                    Background="#14F5B942"
                    BorderBrush="#38F5B942"
                    BorderThickness="1"
                    CornerRadius="10"
                    IsVisible="{Binding IsRestartRequired}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Width="16"
                              Height="16"
                              Foreground="#F5B942"
                              VerticalAlignment="Center"
                              Data="{StaticResource Icon.Warning}" />
                    <TextBlock Text="部分初始化设置已更改，将在重新启动 Reikou 后生效。"
                               Foreground="#F5B942"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Panel Grid.Row="2" Margin="0,20,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <Grid MaxWidth="880"
                          Margin="36,0,36,32"
                          HorizontalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding VisibleOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
                <StackPanel IsVisible="{Binding !HasVisibleOptions}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10">
                    <PathIcon Width="40"
                              Height="40"
                              HorizontalAlignment="Center"
                              Foreground="#3A3F4A"
                              Data="{StaticResource Icon.Search}" />
                    <TextBlock Text="未找到匹配的设置"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#9AA1AB"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="尝试更换关键字，或从左侧分类中浏览"
                               FontSize="12.5"
                               Foreground="#6E7580"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Panel>
        </Grid>
    </Grid>
</UserControl>
